# Copie este arquivo para ".env" e preencha.
PORT=3000

# SMTP (para enviar o e-mail de confirmação). Se deixar vazio, o site
# continua salvando os e-mails, mas não envia nada.
# Exemplo com Gmail (precisa de "senha de app", veja o LEIA-ME):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
MAIL_FROM="Incógnita <seuemail@gmail.com>"

# (opcional) receber um aviso a cada nova inscrição
NOTIFY_TO=

# (opcional) endereço do site, usado no botão do e-mail. Só coloque quando o site estiver no ar.
SITE_URL=
